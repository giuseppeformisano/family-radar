<?xml version="1.0" encoding="utf-8"?>
<!--
  Primo piano dell'icona adattiva: un radar con tre onde concentriche, il settore
  di scansione e tre punti — il centro sei tu, gli altri due i familiari.
  Stessa idea di RadarPulseAnimation, così l'icona e la schermata si somigliano.

  Vincolo geometrico delle adaptive icon: il viewport è 108x108dp ma solo il
  cerchio centrale di 72dp di diametro (raggio 36 dal centro 54,54) è garantito
  visibile — il resto può essere mangiato dalla maschera del launcher. Qui il
  disegno sta tutto entro raggio 32, con un margine di sicurezza.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Settore di scansione, dall'alto verso destra -->
    <path
        android:pathData="M54,54 L54,23 A31,31 0 0,1 82.1,40.9 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.22" />

    <!-- Onda esterna -->
    <path
        android:pathData="M23,54 a31,31 0 1,0 62,0 a31,31 0 1,0 -62,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.6"
        android:strokeAlpha="0.45" />

    <!-- Onda intermedia -->
    <path
        android:pathData="M32,54 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.8"
        android:strokeAlpha="0.7" />

    <!-- Onda interna -->
    <path
        android:pathData="M41,54 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeAlpha="0.9" />

    <!-- Familiare 1 (teal, come SecondaryDark) -->
    <path
        android:pathData="M29.06,63.3 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#FF2DD4BF" />

    <!-- Familiare 2 (ambra, come TertiaryDark) -->
    <path
        android:pathData="M64.56,69.56 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#FFFBBF24" />

    <!-- Tu, al centro -->
    <path
        android:pathData="M47.5,54 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0"
        android:fillColor="#FFFFFF" />
</vector>
