<?xml version="1.0" encoding="utf-8"?>
<!--
  Sfondo dell'icona adattiva.

  Il viewport è 108x108dp per convenzione delle adaptive icon: il sistema può
  ritagliarlo in cerchio, quadrato o squircle a seconda del launcher, quindi lo
  sfondo deve essere pieno fino ai bordi e non contenere nulla di significativo.

  Gradiente indigo, gli stessi toni di PrimaryLight/Indigo900 in ui/theme/Color.kt.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF6366F1" />
                <item android:offset="0.55" android:color="#FF4F46E5" />
                <item android:offset="1" android:color="#FF312E81" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
